# Copy this file to .env and fill in real values before starting the server.
# Never commit the real .env file.

# Password that unlocks admin editing. Wrap it in quotes if it contains '#'.
ADMIN_PASSWORD="change-this-password"

# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Port the app listens on internally (nginx proxies to this).
PORT=3000

# Set to true once the site is served over HTTPS through a reverse proxy.
USE_SECURE_COOKIE=false
